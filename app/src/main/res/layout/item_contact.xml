<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/comic_background_item"
    android:padding="12dp">

    <!-- Left-aligned Contact Name -->
    <TextView
        android:id="@+id/contact_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="10dp"
        android:text="@string/contact_item_name"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="@font/fredoka_standard"
        android:gravity="start" />

    <!-- Right-aligned Contact Number -->
    <TextView
        android:id="@+id/contact_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/contact_item_number"
        android:textSize="18sp"
        android:fontFamily="@font/fredoka_standard"
        android:gravity="end" />

</LinearLayout>
