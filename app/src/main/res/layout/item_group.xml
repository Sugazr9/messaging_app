<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/comic_background_item"
    android:padding="12dp">

    <!-- Group Name (Left Aligned) -->
    <TextView
        android:id="@+id/group_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/group_item_name"
        android:textSize="20sp"
        android:textColor="@color/colorPrimaryDark"
        android:ellipsize="end"
        android:textStyle="bold"
        android:fontFamily="@font/luckiest_guy"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/group_contacts_count" />

    <!-- Number of Contacts (Right Aligned) -->
    <TextView
        android:id="@+id/group_contacts_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/group_item_contact_num"
        android:textSize="16sp"
        android:textColor="@color/colorAccent"
        android:textStyle="bold"
        android:fontFamily="@font/fredoka_standard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>