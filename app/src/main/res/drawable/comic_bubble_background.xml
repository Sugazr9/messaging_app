<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/colorAccent" />
            <corners android:radius="0dp" />
            <stroke android:width="3dp" android:color="@color/colorPrimaryDark" />
        </shape>
    </item>
    <item android:gravity="fill">
        <bitmap android:src="@drawable/your_transparent_image2_resize"
            android:tileMode="repeat" />
    </item>
    <!-- Transparent gradient circle to fade the dots in the center -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:gradientRadius="60%"
                android:type="radial"
                android:centerColor="@color/colorAccent"
                android:endColor="@android:color/transparent"
                android:startColor="@color/colorAccent"
                android:useLevel="false" />
        </shape>
    </item>
</layer-list>